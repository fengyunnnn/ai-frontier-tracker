{
  "name": "ai-frontier-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "predev": "node scripts/sync-content.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/sync-content.mjs && node --test tests/content-sync.test.mjs tests/governance.test.mjs",
    "lint": "eslint app/main.tsx app/trend-explorer.tsx vite.config.ts",
    "check": "pnpm test && pnpm lint && pnpm build"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
